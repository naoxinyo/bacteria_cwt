# Flask配置
FLASK_CONFIG=development
SECRET_KEY=your-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-key-here

# 数据库配置
DATABASE_URL=postgresql://username:password@localhost/teaching_ai_db
DEV_DATABASE_URL=postgresql://postgres:password@localhost/teaching_ai_dev
TEST_DATABASE_URL=postgresql://postgres:password@localhost/teaching_ai_test

# DeepSeek API配置
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 文件上传配置
UPLOAD_FOLDER=uploads

# 邮件配置（可选）
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-email-password
